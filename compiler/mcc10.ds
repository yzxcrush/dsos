// mcc10.ds — 支持自身所需内建（store8/load8/store32/load32/sys_exit）（⑤ 第十二圈，自举预备）
// 新增：fn <name>(<p1>,<p2>) { ... }  定义；<name>(<a>,<b>) 调用（支持前向调用）
// 函数返回值 = 尾声时的 eax（最后一条赋值的结果）
// 内存新增：0x3300 调用修复表哈希 / 0x3380 位置 / 0x3400 计数
//          0x3500 函数表哈希 / 0x3580 偏移 / 0x3600 计数

fn peek(s: *u8) -> i32 { return load8(s + load32(12288)) }
fn peek_at(s: *u8, k: i32) -> i32 { return load8(s + load32(12288) + k) }
fn advance() -> i32 { store32(12288, load32(12288) + 1)  return 0 }
fn skip(s: *u8) -> i32 {
    let more = 1
    while more == 1 {
        more = 0
        if peek(s) == 32 { advance()  more = 1 }
        if peek(s) == 10 { advance()  more = 1 }
        if peek(s) == 13 { advance()  more = 1 }
        if peek(s) == 9 { advance()  more = 1 }
        if peek(s) == 47 {
            if peek_at(s, 1) == 47 {
                while peek(s) != 10 {
                    if peek(s) == 0 { return 0 }
                    advance()
                }
                advance()
                more = 1
            }
        }
    }
    return 0
}
fn emit(b: i32) -> i32 { store8(24576 + load32(12296), b)  store32(12296, load32(12296) + 1)  return 0 }
fn emit32(v: i32) -> i32 { emit(v as u8)  emit((v >> 8) as u8)  emit((v >> 16) as u8)  emit((v >> 24) as u8)  return 0 }

fn is_digit(c: i32) -> i32 { if c >= 48 { if c <= 57 { return 1 } }  return 0 }
fn is_alpha(c: i32) -> i32 { if c >= 97 { if c <= 122 { return 1 } }  return 0 }
fn is_ident(c: i32) -> i32 {
    if is_alpha(c) == 1 { return 1 }
    if is_digit(c) == 1 { return 1 }
    if c == 95 { return 1 }
    return 0
}

fn hash_ident(s: *u8) -> i32 {
    let hh = 0
    let p = load32(12288)
    while is_ident(load8(s + p)) == 1 { hh = hh * 33 + load8(s + p)  p = p + 1 }
    return hh & 65535
}

fn ident_len(s: *u8) -> i32 {
    let n = 0
    let p = load32(12288)
    while is_ident(load8(s + p)) == 1 { n = n + 1  p = p + 1 }
    return n
}

fn skip_ident(s: *u8) -> i32 {
    let n = ident_len(s)
    let i = 0
    while i < n { advance()  i = i + 1 }
    return 0
}

// ---- 变量符号表 ----
fn sym_set(hh: i32, off: i32) -> i32 {
    let n = load32(409600)
    store32(393216 + (n * 4), hh)
    store32(401408 + (n * 4), off)
    store32(409600, n + 1)
    return 0
}
fn sym_get(hh: i32) -> i32 {
    let n = load32(409600)
    let i = 0
    while i < n {
        if load32(393216 + (i * 4)) == hh { return load32(401408 + (i * 4)) }
        i = i + 1
    }
    store32(15360, load32(12288))      // 调试：记录未命中时的源码位置
    return 0
}

// ---- 函数表 ----
fn fn_set(hh: i32, off: i32) -> i32 {
    let n = load32(319488)
    store32(303104 + (n * 4), hh)
    store32(311296 + (n * 4), off)
    store32(319488, n + 1)
    return 0
}
fn fn_get(hh: i32) -> i32 {
    let n = load32(319488)
    let i = 0
    while i < n {
        if load32(303104 + (i * 4)) == hh { return load32(311296 + (i * 4)) }
        i = i + 1
    }
    return 0
}

// ---- 调用修复表 ----
fn fix_add(hh: i32, pos: i32) -> i32 {
    let n = load32(294912)
    store32(262144 + (n * 4), hh)
    store32(278528 + (n * 4), pos)
    store32(294912, n + 1)
    return 0
}
fn resolve_calls() -> i32 {
    let n = load32(294912)
    let i = 0
    while i < n {
        let hh = load32(262144 + (i * 4))
        let pos = load32(278528 + (i * 4))
        let target = fn_get(hh)
        let disp = target - (pos + 4)
        // 未知函数（如源码没有 _start 时的入口调用）：位移置 0 = call 到下一条指令
        if target == 0 { disp = 0 }
        store8(24576 + pos, disp as u8)
        store8(24576 + pos + 1, (disp >> 8) as u8)
        store8(24576 + pos + 2, (disp >> 16) as u8)
        store8(24576 + pos + 3, (disp >> 24) as u8)
        i = i + 1
    }
    return 0
}

fn number(s: *u8) -> i32 {
    let n = 0
    while is_digit(peek(s)) == 1 { n = n * 10 + (peek(s) - 48)  advance() }
    return n
}

fn emit_call(s: *u8) -> i32 {
    let hh = hash_ident(s)
    skip_ident(s)
    skip(s)
    advance()
    let nargs = 0
    skip(s)
    while peek(s) != 41 {
        emit_expr(s)
        emit(80)
        nargs = nargs + 1
        skip(s)
        if peek(s) == 44 { advance()  skip(s) }
    }
    advance()
    if nargs >= 2 { emit(94) }
    if nargs >= 1 { emit(95) }
    emit(232)
    let pos = load32(12296)
    emit(0)  emit(0)  emit(0)  emit(0)
    fix_add(hh, pos)
    return 0
}

// ---------- 内建代码生成 ----------
fn skip_name_and_paren(s: *u8) -> i32 {
    skip_ident(s)
    skip(s)
    advance()
    skip(s)
    return 0
}

fn skip_comma(s: *u8) -> i32 {
    skip(s)
    advance()
    skip(s)
    return 0
}

fn close_paren(s: *u8) -> i32 {
    skip(s)
    advance()
    return 0
}

// store8(addr, val)  ->  push val ; eval addr ; pop rbx ; mov [rax], bl
fn intr_store8(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)                       // 值
    emit(80)                           // push rax
    skip_comma(s)
    emit_expr(s)                       // 地址
    emit(91)                           // pop rbx（地址）
    emit(136)  emit(3)                 // mov [rbx], al
    close_paren(s)
    return 0
}

// load8(addr) -> eval addr ; movzx eax, byte [rax]
fn intr_load8(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)
    emit(15)  emit(182)  emit(0)       // movzx eax, byte [rax]
    close_paren(s)
    return 0
}

// store32(addr, val) -> push val ; eval addr ; pop rbx ; mov [rax], ebx
fn intr_store32(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)
    emit(80)
    skip_comma(s)
    emit_expr(s)
    emit(91)                           // pop rbx（地址）
    emit(137)  emit(3)                 // mov [rbx], eax
    close_paren(s)
    return 0
}

// load32(addr) -> eval addr ; mov eax, [rax]
fn intr_load32(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)
    emit(139)  emit(0)                 // mov eax, [rax]
    close_paren(s)
    return 0
}

// run(addr) -> call rax（执行指定地址的机器码）
fn intr_run(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)
    emit(255)  emit(208)               // call rax
    close_paren(s)
    return 0
}

// sys_exit(v) -> mov rdi,rax ; mov eax,60 ; syscall
fn intr_sys_exit(s: *u8) -> i32 {
    skip_name_and_paren(s)
    emit_expr(s)
    emit(72)  emit(137)  emit(199)     // mov rdi, rax
    emit(184)  emit(60)  emit(0)  emit(0)  emit(0)   // mov eax, 60
    emit(15)  emit(5)                  // syscall
    close_paren(s)
    return 0
}

// 从当前位置向前扫描到匹配的 ')'，判断括号内是否是"条件"
// （深度 0 出现 < > = 即视为条件）
fn has_cmp(s: *u8) -> i32 {
    let p = load32(12288)
    let depth = 0
    let i = 0
    while i < 400 {
        let c = load8(s + p + i)
        if c == 0 { return 0 }
        if c == 40 { depth = depth + 1 }
        if c == 41 {
            depth = depth - 1
            if depth < 0 { return 0 }
        }
        if depth == 0 {
            if c == 61 { return 1 }
            if c == 60 || c == 62 {
                let nx = load8(s + p + i + 1)
                if nx == c { i = i + 1 } else { return 1 }
            }
        }
        i = i + 1
    }
    return 0
}

fn emit_factor(s: *u8) -> i32 {
    skip(s)
    let c = peek(s)
    if is_digit(c) == 1 { let n = number(s)  emit(184)  emit32(n)  return 0 }
    let hh = hash_ident(s)
    let ln = ident_len(s)
    if c == 40 {
        advance()
        if has_cmp(s) == 1 { parse_cond(s) } else { emit_expr(s) }
        skip(s)
        advance()
        return 0
    }
    if peek_at(s, ln) == 40 {
        // ---- 内建：编译器自身源码要用到它们，才能编译自己 ----
        if hh == 11013 { return intr_store8(s) }
        if hh == 56888 { return intr_load8(s) }
        if hh == 35634 { return intr_store32(s) }
        if hh == 42181 { return intr_load32(s) }
        if hh == 7992 { return intr_sys_exit(s) }
        if hh == 62581 { return intr_run(s) }
        return emit_call(s)
    }
    skip_ident(s)
    let sl = sym_get(hh)
    if sl == 0 { store32(15364, hh)  store32(15368, load32(12288)) }    // 调试：哈希 + pos
    emit(139)  emit(133)  emit32(sl)
    return 0
}

fn emit_bool(is_or: i32) -> i32 {
    // rbx = 左值, rax = 右值；非短路求值
    emit(72)  emit(133)  emit(219)          // test rbx, rbx
    emit(15)  emit(149)  emit(195)          // setne bl
    emit(72)  emit(133)  emit(192)          // test rax, rax
    emit(15)  emit(149)  emit(192)          // setne al
    if is_or == 1 { emit(8)  emit(216) } else { emit(32)  emit(216) }
    emit(15)  emit(182)  emit(192)          // movzx eax, al
    return 0
}

fn emit_expr(s: *u8) -> i32 {
    emit_factor(s)
    skip(s)
    // 移位：左值 >> 右值（独立循环，优先级高于其他二元运算）
    while peek(s) == 62 && peek_at(s, 1) == 62 {
        advance()  advance()  skip(s)
        emit(80)
        emit_factor(s)
        emit(91)
        emit(72)  emit(137)  emit(193)      // mov rcx,rax
        emit(72)  emit(211)  emit(235)      // shr rbx,cl
        emit(72)  emit(137)  emit(216)      // mov rax,rbx
        skip(s)
    }
    while peek(s) == 43 || peek(s) == 45 || peek(s) == 42 || (peek(s) == 124 && peek_at(s, 1) != 124) || (peek(s) == 38 && peek_at(s, 1) != 38) {
        let op = peek(s)
        advance()
        skip(s)
        emit(80)
        emit_factor(s)
        emit(91)
        if op == 43 { emit(1)  emit(216) } else {
            if op == 42 { emit(15)  emit(175)  emit(195) } else {
                if op == 62 {
                    // >> ：先吃掉第二个 '>'，再 mov rcx,rbx ; shr rax,cl
                    advance()
                    emit(72)  emit(137)  emit(217)          // mov rcx,rbx
                    emit(72)  emit(211)  emit(232)          // shr rax,cl
                } else {
                    if op == 124 { emit_bool(1) } else {
                        if op == 38 {
                            if peek(s) == 38 { emit_bool(0) } else {
                                // 单个 & 是**按位与**（&& 才是逻辑与）
                                emit(72)  emit(33)  emit(216)   // and rax,rbx
                            }
                        } else {
                            emit(41)  emit(195)  emit(137)  emit(216)
                        }
                    }
                }
            }
        }
        skip(s)
    }
    // 类型转换 "expr as u8"：值已在 eax，只需跳过 "as <类型>"
    skip(s)
    while hash_ident(s) == 3316 {
        skip_ident(s)
        skip(s)
        while is_ident(peek(s)) == 1 { advance() }
        skip(s)
    }
    return 0
}

// 表达式或条件：先按表达式解析，若停在比较运算符上则回滚重解析
fn emit_value(s: *u8) -> i32 {
    let sp = load32(12288)
    let sl = load32(12296)
    emit_expr(s)
    skip(s)
    if peek(s) == 60 || peek(s) == 62 || peek(s) == 61 {
        store32(12288, sp)
        store32(12296, sl)
        parse_cond(s)
    }
    return 0
}

fn emit_let(s: *u8) -> i32 {
    skip_ident(s)
    skip(s)
    let hh = hash_ident(s)
    skip_ident(s)
    skip(s)
    advance()
    skip(s)
    let slot2 = 0 - (4 * (load32(409600) + 1))
    sym_set(hh, slot2)
    emit_value(s)
    emit(137)  emit(133)  emit32(slot2)
    return 0
}

fn emit_assign(s: *u8) -> i32 {
    let hh = hash_ident(s)
    skip_ident(s)
    skip(s)
    advance()
    skip(s)
    emit_expr(s)
    emit(137)  emit(133)  emit32(sym_get(hh))
    return 0
}

fn emit_cmp_bool(s: *u8) -> i32 {
    // 左值用完整表达式解析（这样 freak(s) == 58、a+b > c 都支持）
    emit_expr(s)
    emit(80)                           // push rax（左值）
    skip(s)
    let op1 = peek(s)
    advance()
    let op2 = 0
    if peek(s) == 61 { op2 = 61  advance() }
    skip(s)
    emit_expr(s)                       // 右值 -> rax
    emit(91)                           // pop rbx（左值）
    emit(72)  emit(57)  emit(195)      // cmp rbx, rax（左 - 右）
    if op1 == 60 {
        if op2 == 61 { emit(15)  emit(158)  emit(192) } else { emit(15)  emit(156)  emit(192) }
    } else {
        if op1 == 62 {
            if op2 == 61 { emit(15)  emit(157)  emit(192) } else { emit(15)  emit(159)  emit(192) }
        } else {
            if op1 == 61 { emit(15)  emit(148)  emit(192) } else { emit(15)  emit(149)  emit(192) }
        }
    }
    emit(15)  emit(182)  emit(192)     // movzx eax, al
    return 0
}

// 条件项：可能是普通比较，也可能是括号包起来的子条件
fn cond_term(s: *u8) -> i32 {
    skip(s)
    if peek(s) == 40 {
        advance()
        parse_cond(s)
        skip(s)
        advance()
    } else {
        emit_cmp_bool(s)
    }
    return 0
}

fn parse_cond(s: *u8) -> i32 {
    cond_term(s)
    skip(s)
    while peek(s) == 38 || peek(s) == 124 {
        let is_and = peek(s) == 38
        advance()
        advance()
        skip(s)
        emit(80)
        cond_term(s)
        emit(91)
        emit(72)  emit(133)  emit(219)
        emit(15)  emit(149)  emit(195)
        emit(72)  emit(133)  emit(192)
        emit(15)  emit(149)  emit(192)
        if is_and == 1 { emit(32)  emit(216) } else { emit(8)  emit(216) }
        emit(15)  emit(182)  emit(192)
        skip(s)
    }
    return 0
}

fn emit_if(s: *u8) -> i32 {
    skip_ident(s)
    skip(s)
    parse_cond(s)
    skip(s)
    advance()
    emit(72)  emit(133)  emit(192)
    emit(15)  emit(132)
    let jf = load32(12296)
    emit(0)  emit(0)  emit(0)  emit(0)
    skip(s)
    while peek(s) != 125 { emit_stmt(s)  skip(s) }
    advance()
    skip(s)
    let is_else = 0
    if peek(s) == 101 { if peek_at(s, 1) == 108 { is_else = 1 } }
    if is_else == 1 {
        emit(233)
        let je = load32(12296)
        emit(0)  emit(0)  emit(0)  emit(0)
        let elstart = load32(12296)
        let dj0 = elstart - (jf + 4)
        store8(24576 + jf, dj0 as u8)
        store8(24576 + jf + 1, (dj0 >> 8) as u8)
        store8(24576 + jf + 2, (dj0 >> 16) as u8)
        store8(24576 + jf + 3, (dj0 >> 24) as u8)
        skip_ident(s)
        skip(s)
        advance()
        skip(s)
        while peek(s) != 125 { emit_stmt(s)  skip(s) }
        advance()
        let after = load32(12296)
        let d = after - (je + 4)
        store8(24576 + je, d as u8)
        store8(24576 + je + 1, (d >> 8) as u8)
        store8(24576 + je + 2, (d >> 16) as u8)
        store8(24576 + je + 3, (d >> 24) as u8)
        return 0
    }
    let after2 = load32(12296)
    let dj1 = after2 - (jf + 4)
    store8(24576 + jf, dj1 as u8)
    store8(24576 + jf + 1, (dj1 >> 8) as u8)
    store8(24576 + jf + 2, (dj1 >> 16) as u8)
    store8(24576 + jf + 3, (dj1 >> 24) as u8)
    return 0
}

fn emit_while(s: *u8) -> i32 {
    skip_ident(s)
    skip(s)
    let cond_pos = load32(12296)
    parse_cond(s)
    skip(s)
    advance()
    emit(72)  emit(133)  emit(192)
    emit(15)  emit(132)
    let jf = load32(12296)
    emit(0)  emit(0)  emit(0)  emit(0)
    skip(s)
    while peek(s) != 125 { emit_stmt(s)  skip(s) }
    advance()
    emit(233)                              // jmp rel32（rel8 会因循环体过长而截断）
    let jm = load32(12296)
    let dj = cond_pos - (jm + 4)
    emit(dj as u8)
    emit((dj >> 8) as u8)
    emit((dj >> 16) as u8)
    emit((dj >> 24) as u8)
    let after = load32(12296)
    let dw = after - (jf + 4)
    store8(24576 + jf, dw as u8)
    store8(24576 + jf + 1, (dw >> 8) as u8)
    store8(24576 + jf + 2, (dw >> 16) as u8)
    store8(24576 + jf + 3, (dw >> 24) as u8)
    return 0
}

fn emit_fn(s: *u8) -> i32 {
    skip_ident(s)
    skip(s)
    let hh = hash_ident(s)
    skip_ident(s)
    skip(s)
    advance()
    store32(409600, 0)                 // 每个函数独立符号表（在参数注册之前）
    let nparams = 0
    skip(s)
    while peek(s) != 41 {
        let ph = hash_ident(s)
        skip_ident(s)
        let pslot = 0 - (4 * (nparams + 1))
        sym_set(ph, pslot)
        nparams = nparams + 1
        skip(s)
        // 跳过参数类型标注：": *u8" / ": i32"
        if peek(s) == 58 {
            advance()
            skip(s)
            let ty = 1
            while ty == 1 {
                ty = 0
                if is_ident(peek(s)) == 1 { advance()  skip(s)  ty = 1 }
                if peek(s) == 42 { advance()  skip(s)  ty = 1 }
            }
        }
        if peek(s) == 44 { advance()  skip(s) }
    }
    advance()
    skip(s)
    // 跳过返回类型 "-> i32"
    if peek(s) == 45 {
        advance()
        advance()
        skip(s)
        let rt = 1
        while rt == 1 {
            rt = 0
            if is_ident(peek(s)) == 1 { advance()  skip(s)  rt = 1 }
            if peek(s) == 42 { advance()  skip(s)  rt = 1 }
        }
    }
    advance()                              // 过 '{'

    // 所有函数走同一路径（含 _start），入口由顶层序言后的 call _start 负责
    let is_entry = 0
    let jmp_over = 0
    if is_entry == 0 {
        emit(233)
        jmp_over = load32(12296)
        emit(0)  emit(0)  emit(0)  emit(0)
    }

    let fn_off = load32(12296)
    fn_set(hh, fn_off)
    emit(85)
    emit(72)  emit(137)  emit(229)
    emit(72)  emit(129)  emit(236)  emit32(4096)
    if nparams >= 1 { emit(137)  emit(189)  emit32(0 -4) }
    if nparams >= 2 { emit(137)  emit(181)  emit32(0 -8) }

    let ret_base = load32(335872)
    skip(s)
    skip(s)
    while peek(s) != 125 { emit_stmt(s)  skip(s) }
    advance()

    // 回填本函数内所有 return 的 jmp → 尾声起点
    let ep = load32(12296)
    while load32(335872) > ret_base {
        store32(335872, load32(335872) - 1)
        let rp2 = load32(327680 + (load32(335872) * 4))
        let rd = ep - (rp2 + 4)
        store8(24576 + rp2, rd as u8)
        store8(24576 + rp2 + 1, (rd >> 8) as u8)
        store8(24576 + rp2 + 2, (rd >> 16) as u8)
        store8(24576 + rp2 + 3, (rd >> 24) as u8)
    }

    emit(72)  emit(137)  emit(236)
    emit(93)
    emit(195)

    if is_entry == 0 {
        let after = load32(12296)
        let d = after - (jmp_over + 4)
        store8(24576 + jmp_over, d as u8)
        store8(24576 + jmp_over + 1, (d >> 8) as u8)
        store8(24576 + jmp_over + 2, (d >> 16) as u8)
        store8(24576 + jmp_over + 3, (d >> 24) as u8)
    }
    return 0
}

// return 跳转修复表（0x3A00 位置 / 0x3B00 计数）
fn ret_add(pos: i32) -> i32 {
    store32(327680 + (load32(335872) * 4), pos)
    store32(335872, load32(335872) + 1)
    return 0
}

fn emit_stmt(s: *u8) -> i32 {
    skip(s)
    let hh = hash_ident(s)
    if hh == 3476 { emit_fn(s)  return 0 }
    if hh == 55525 { emit_let(s)  return 0 }
    if hh == 3567 { emit_if(s)  return 0 }
    if hh == 14425 { emit_while(s)  return 0 }
    if hh == 24416 {
        // return [expr]：先求值（结果留在 eax），再跳到函数尾声
        skip_ident(s)
        skip(s)
        if peek(s) != 125 { emit_expr(s)  skip(s) }
        emit(233)
        let rp = load32(12296)
        emit(0)  emit(0)  emit(0)  emit(0)
        ret_add(rp)
        return 0
    }
    // 表达式语句：标识符后紧跟 '(' （函数调用 / 内建调用）
    let ln = ident_len(s)
    if peek_at(s, ln) == 40 { emit_expr(s)  return 0 }
    emit_assign(s)
    return 0
}

fn _start() {
    store32(12288, 0)
    store32(12296, 0)
    store32(409600, 0)
    store32(294912, 0)
    store32(319488, 0)
    store32(335872, 0)

    emit(85)
    emit(72)  emit(137)  emit(229)
    emit(72)  emit(129)  emit(236)  emit32(64)

    // 程序入口：调用源程序里的 _start（前向引用，靠调用修复表回填）
    emit(232)
    fix_add(23917, load32(12296))
    emit(0)  emit(0)  emit(0)  emit(0)

    let s = 131072
    while peek(s) != 0 { emit_stmt(s)  skip(s) }

    emit(72)  emit(137)  emit(236)
    emit(93)
    emit(195)
    emit(195)

    resolve_calls()

    if load8(131072) == 64 { sys_exit(load32(12296)) }
    sys_exit(0)
}
