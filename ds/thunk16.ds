// thunk16.ds — 日志落盘 thunk（16 位实模式），用 Ds 编写
//
// 用途：内核在长模式下无法调用 BIOS，所以把日志放在低端内存 0x10000，
// 再由这段 16 位代码用 BIOS int 13h AH=03 写进 U 盘的日志分区。
//
// 目标固定（编译器只支持字面量参数）：
//   源缓冲  0x10000（DS/ES = 0x1000，偏移 0）
//   目标    LBA 6144 = CHS(cyl=0, head=97, sector=34)
//   长度    8 扇区 = 4 KiB
//
// 写之前先在缓冲区头部放 "DSLOG1" 魔数，便于 PC 端识别。

fn _start16() {
    set_ds(0)
    set_es(0)
    set_ss(0)
    mov_sp(31744)                     // 0x7C00

    // 缓冲区头部写魔数 "DSLOG1"（DS 指向 0x1000 段 = 线性 0x10000）
    set_ds(4096)
    write8(0, 68)                     // 'D'
    write8(1, 83)                     // 'S'
    write8(2, 76)                     // 'L'
    write8(3, 79)                     // 'O'
    write8(4, 71)                     // 'G'
    write8(5, 49)                     // '1'
    set_ds(0)

    // 写 8 扇区到日志分区起点（LBA 6144）
    disk_write_lba(6144, 8, 4096, 0)

    halt()
}
