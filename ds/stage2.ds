// stage2.ds — DsOS 第二级引导（16 位实模式），用 Ds 编写
//
// 职责：把 CPU 从实模式带进长模式，然后跳进内核。
//
//   1. 开 A20
//   2. 清页表区 0x1000..0x3FFF
//   3. 写三层页表：PML4 → PDPT → PD（2 MiB 恒等映射）
//   4. 写 GDT（null / 64 位代码 / 数据）与 GDTR
//   5. lgdt → CR3 → CR4.PAE → EFER.LME → CR0.PG|PE
//   6. 远跳到 64 位代码段 0x08，目标 = 内核 0x9000
//
// 内存布局（低端）：
//   0x0500  BIOS DAP（MBR 用）
//   0x1000  PML4
//   0x2000  PDPT
//   0x3000  PD
//   0x5EF0  GDTR 描述符
//   0x5F00  GDT
//   0x8000  本 stage2
//   0x9000  内核
// 本文件没有一行汇编——所有指令都由 mini16.py 生成。

fn _start16() {
    // ---- 0. 段与栈（MBR 已设过，这里再确认一次）----
    set_ds(0)
    set_es(0)
    set_ss(0)
    mov_sp(31744)                       // 0x7C00

    // ---- 1. 打开 A20（fast gate，端口 0x92）----
    a20_fast()

    // ---- 2. 清页表区：0x1000..0x3FFF 共 0x3000 字节 = 0x1800 个 16 位字 ----
    mem_zero(4096, 6144)

    // ---- 3. 页表（2 MiB 大页，恒等映射 0..2MiB）----
    write32(4096, 8195)                 // PML4[0] = 0x2003 (指向 PDPT, P|RW)
    write32(8192, 12291)                // PDPT[0] = 0x3003 (指向 PD,   P|RW)
    write32(12288, 131)                 // PD[0]   = 0x0083 (2MB 页, P|RW|PS)

    // ---- 4. GDT + GDTR ----
    //  0x00 null
    //  0x08 64 位代码：0x00AF9A000000FFFF
    //  0x10 数据：      0x00CF92000000FFFF
    write32(24328, 65535)               // 0x5F08 = 0x0000FFFF  (limit)
    write32(24332, 11508224)            // 0x5F0C = 0x00AF9A00  (base/flags)
    write32(24336, 65535)               // 0x5F10
    write32(24340, 13603328)            // 0x5F14 = 0x00CF9200
    write16(24304, 23)                  // GDTR.limit = 23（3 项 × 8 - 1）
    write32(24306, 24320)               // GDTR.base  = 0x5F00

    // ---- 5. 装 GDT ----
    lgdt_imm(24304)

    // ---- 6. 打开 PAE / LME / 分页 ----
    cr3_set(4096)                       // PML4 物理地址
    cr4_set(32)                         // CR4.PAE = 1
    efer_set(256)                       // IA32_EFER.LME = 1
    cr0_set(2147483665)                 // CR0 = PG|ET|PE = 0x80000011

    // ---- 7. 远跳进 64 位代码段，目标即内核入口 ----
    far_jmp(8, 36864)                   // sel = 0x08, off = 0x9000

    halt()
}
