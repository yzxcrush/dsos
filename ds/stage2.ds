// stage2.ds — DsOS 第二级引导（Ds 编写）
//
// 关键顺序（第一版错在这里）：
//   实模式下写 CR3/CR4 是非法的 → 必须**先进保护模式**，
//   并在保护模式里重载 DS/ES/SS（实模式的 0 是非法选择子），
//   然后才设 PAE / CR3 / EFER，最后开 PG。
//
// 进度标记（'1'..'8' 打到 VGA 第 1 行的不同列）：
//   '1' 段与栈就绪            '5' lgdt 完成
//   '2' A20 已开              '6' 已进 16 位保护模式且段寄存器已重载
//   '3' 页表已写              '7' CR3 / CR4.PAE / EFER.LME 就绪
//   '4' GDT 已写              '8' CR0.PG 已开（即将远跳 64 位）
//
// 判读：停在哪个数字就是那一步之后出的问题。
//
// 内存布局：
//   0x1000 PML4 / 0x2000 PDPT / 0x3000 PD
//   0x5EF0 GDTR / 0x5F00 GDT（null / 16位代码 / 64位代码 / 数据）
//   0x8000 本 stage2 / 0x9000 内核

fn _start16() {
    set_ds(0)
    set_es(0)
    set_ss(0)
    mov_sp(31744)                       // 0x7C00
    vga_mark_rm(49, 0)                  // '1'

    a20_fast()
    vga_mark_rm(50, 1)                  // '2'

    mem_zero(4096, 6144)                // 清 0x1000..0x3FFF
    write32(4096, 8195)                 // PML4[0] = 0x2003
    write32(8192, 12291)                // PDPT[0] = 0x3003
    write32(12288, 131)                 // PD[0]   = 0x0083
    vga_mark_rm(51, 2)                  // '3'

    // GDT：null / 0x08 16位代码 / 0x10 64位代码 / 0x18 数据
    write32(24328, 65535)               // 0x5F08 low
    write32(24332, 39424)               // 0x5F0C high = 0x00009A00（16 位代码）
    write32(24336, 65535)               // 0x5F10 low
    write32(24340, 11508224)            // 0x5F14 high = 0x00AF9A00（64 位代码）
    write32(24344, 65535)               // 0x5F18 low
    write32(24348, 13603328)            // 0x5F1C high = 0x00CF9200（数据）
    write16(24304, 31)                  // GDTR.limit = 4*8-1
    write32(24306, 24320)               // GDTR.base  = 0x5F00
    vga_mark_rm(52, 3)                  // '4'

    lgdt_imm(24304)
    vga_mark_rm(53, 4)                  // '5'

    // ---- 进 16 位保护模式 ----
    cr0_set(1)                          // CR0.PE = 1
    far_jmp_next(8, 32768)              // CS = 0x08，跳到下一句
    set_flat(24)                        // DS/ES/SS = 0x18（平坦数据段）
    vga_mark32(54, 5)                   // '6'

    // ---- 长模式前置条件 ----
    cr3_set(4096)                       // PML4
    cr4_set(32)                         // CR4.PAE
    efer_set(256)                       // IA32_EFER.LME
    vga_mark32(55, 6)                   // '7'

    // ---- 开分页 → IA-32e 兼容模式 ----
    cr0_set(2147483665)                 // CR0 = PG|ET|PE
    vga_mark32(56, 7)                   // '8'

    // ---- 32 位操作数远跳进 64 位代码段 ----
    far_jmp32(16, 36864)                // sel = 0x10, off = 0x9000

    halt()
}
