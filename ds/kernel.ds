// kernel.ds — DsOS 最小内核 v1.1（全部字节由 Ds 源码经 Ds 工具链编译）
//
// 屏幕布局（80x25）：
//   row 0    标题
//   row 1    副标题（证明由 Ds 工具链编译）
//   row 2    分隔线
//   row 4-19 日志区（满则上滚）
//   row 21   心跳：[beat NNNN] + 旋转 | / - \
//   row 22   命令行：cmd> 输入回显
//   row 24   状态栏
//
// 命令：help / log（翻看内存日志环） / shutdown / off（关机快捷键） / ESC（停机）
//
// 日志同时写两处：
//   1. 屏幕（4..19 行，上滚）
//   2. 内存环形缓冲 0x4000..0x4EFF（60 槽 × 64 字节，计数在 0x4F00）
//      —— `log` 命令可翻看完整历史，不受屏幕滚动限制
//
// 本文件中没有一行 C，也没有一行汇编——所有指令都由 Ds 编译器生成。

// ---------- VGA ----------
fn vga_put2(row: i32, col: i32, cp: i32) -> i32 {
    let base = 753664 + row * 160 + col * 2
    store8(base, cp & 255)
    store8(base + 1, (cp >> 8) & 255)
    return 0
}

fn vga_put(row: i32, col: i32, ch: i32) -> i32 {
    return vga_put2(row, col, ch | 3840)
}

fn clear() -> i32 {
    let i = 0
    while i < 2000 {
        store8(753664 + i * 2, 32)
        store8(753664 + i * 2 + 1, 7)
        i = i + 1
    }
    return 0
}

fn clear_row(r: i32) -> i32 {
    let c = 0
    while c < 80 {
        vga_put(r, c, 32)
        c = c + 1
    }
    return 0
}

fn puts_at(row: i32, col0: i32, s: *u8) -> i32 {
    let i = 0
    let c = 1
    while c != 0 {
        c = load8(s + i)
        if c == 0 { return 0 }
        vga_put(row, col0 + i, c)
        i = i + 1
    }
    return 0
}

fn hexc(n: i32) -> i32 {
    if n < 10 { return 48 + n }
    return 87 + n
}

// ---------- 内存日志环 ----------
// 0x4000 起 60 槽 × 64 字节；0x4F00 存已写入的条数
fn logstore(s: *u8) -> i32 {
    let n = load32(20224)
    let base = 16384 + (n & 63) * 64
    let i = 0
    let c = 1
    while c != 0 {
        c = load8(s + i)
        if c == 0 {
            store8(base + i, 0)
            store32(20224, n + 1)
            return 0
        }
        if i < 62 { store8(base + i, c) }
        i = i + 1
    }
    return 0
}

fn dump_log() -> i32 {
    let n = load32(20224)
    let start = 0
    if n > 60 { start = n - 60 }
    let k = start
    let r = 4
    while r < 20 {
        clear_row(r)
        r = r + 1
    }
    r = 4
    while k < n {
        if r > 19 { return 0 }
        puts_at(r, 0, 16384 + (k & 63) * 64)
        r = r + 1
        k = k + 1
    }
    return 0
}

// ---------- 屏幕日志（同时进内存环） ----------
fn scroll_log() -> i32 {
    let r = 4
    while r < 19 {
        let c = 0
        while c < 80 {
            let src = 753664 + ((r + 1) * 80 + c) * 2
            let dst = 753664 + (r * 80 + c) * 2
            store8(dst, load8(src))
            store8(dst + 1, load8(src + 1))
            c = c + 1
        }
        r = r + 1
    }
    clear_row(19)
    return 0
}

fn log(row: i32, s: *u8) -> i32 {
    logstore(s)
    if row > 19 {
        scroll_log()
        row = 19
    }
    puts_at(row, 0, s)
    return row + 1
}

// ---------- 延迟 / 心跳 ----------
fn delay(k: i32) -> i32 {
    let i = 0
    while i < k {
        out8(128, 0)
        i = i + 1
    }
    return 0
}

fn heartbeat(n: i32) -> i32 {
    puts_at(21, 0, "[beat ")
    vga_put(21, 6, hexc((n >> 12) & 15))
    vga_put(21, 7, hexc((n >> 8) & 15))
    vga_put(21, 8, hexc((n >> 4) & 15))
    vga_put(21, 9, hexc(n & 15))
    puts_at(21, 10, "] ")
    let ph = n & 3
    let ch = 124
    if ph == 1 { ch = 47 }
    if ph == 2 { ch = 45 }
    if ph == 3 { ch = 92 }
    vga_put(21, 12, ch)
    return 0
}

fn divider() -> i32 {
    let c = 0
    while c < 80 {
        vga_put2(2, c, 45 | 2048)
        c = c + 1
    }
    return 0
}

fn status_bar() -> i32 {
    let c = 0
    while c < 80 {
        vga_put2(24, c, 32 | 28672)
        c = c + 1
    }
    puts_at(24, 1, "DsOS v1.1 | help log shutdown off irq | ESC = halt")
    return 0
}

// ---------- 扫描码 -> ASCII ----------
fn sc2ascii(sc: i32) -> i32 {
    if sc == 35 { return 104 }          // h
    if sc == 18 { return 101 }          // e
    if sc == 38 { return 108 }          // l
    if sc == 25 { return 112 }          // p
    if sc == 31 { return 115 }          // s
    if sc == 22 { return 117 }          // u
    if sc == 20 { return 116 }          // t
    if sc == 32 { return 100 }          // d
    if sc == 24 { return 111 }          // o
    if sc == 17 { return 119 }          // w
    if sc == 49 { return 110 }          // n
    if sc == 34 { return 103 }          // g  log
    if sc == 33 { return 102 }          // f  off
    if sc == 46 { return 99 }           // c  exc
    if sc == 45 { return 120 }          // x  exc
    if sc == 23 { return 105 }          // i  irq
    if sc == 19 { return 114 }          // r  irq
    if sc == 16 { return 113 }          // q  irq
    if sc == 30 { return 97 }           // a  savelog
    if sc == 47 { return 118 }          // v  savelog
    if sc == 57 { return 32 }           // 空格
    return 0
}

// ---------- ACPI S5 关机 ----------
fn is_rsdp(a: i32) -> i32 {
    if load32(a) != 541348690 { return 0 }         // "RSD "
    if load32(a + 4) != 542266448 { return 0 }     // "PTR "
    return 1
}

fn is_facp(a: i32) -> i32 {
    if load32(a) != 1346584902 { return 0 }        // "FACP"
    return 1
}

fn find_rsdp() -> i32 {
    let a = 917504
    while a < 1048576 {
        if is_rsdp(a) == 1 { return a }
        a = a + 16
    }
    return 0
}

fn find_fadt() -> i32 {
    let r = find_rsdp()
    if r == 0 { return 0 }
    let rsdt = load32(r + 16)
    if rsdt == 0 { return 0 }
    let n = (load32(rsdt + 4) - 36) >> 2
    let i = 0
    while i < n {
        let p = load32(rsdt + 36 + i * 4)
        if is_facp(p) == 1 { return p }
        i = i + 1
    }
    return 0
}

fn shutdown() -> i32 {
    let f = find_fadt()
    if f == 0 { return 0 }
    let pm = load32(f + 64) & 65535
    if pm == 0 { return 0 }
    let val = (5 << 10) | 8192
    out8(pm, val & 255)
    out8(pm + 1, (val >> 8) & 255)
    return 1
}

// ---------- IDT / 异常处理 ----------
// IDT 位于 0x5000（256 项 × 16 字节，只填 0..31 号异常）
// IDTR 描述符位于 0x4F20（limit u16 + base u64）
fn idt_set(vec: i32, off: i32, cs: i32) -> i32 {
    let base = 20480 + vec * 16
    store16(base, off & 65535)               // offset[15:0]
    store16(base + 2, cs)                    // selector
    store8(base + 4, 0)                      // IST
    store8(base + 5, 142)                    // 0x8E: P=1, DPL=0, 64 位中断门
    store16(base + 6, (off >> 16) & 65535)   // offset[31:16]
    store32(base + 8, (off >> 32) & 4294967295)
    store32(base + 12, 0)
    return 0
}

// 异常名（命名报告，便于定位）
fn exc_name(v: i32) -> *u8 {
    if v == 0 { return "0  #DE divide error" }
    if v == 3 { return "3  #BP breakpoint" }
    if v == 6 { return "6  #UD invalid opcode" }
    if v == 8 { return "8  #DF double fault" }
    if v == 13 { return "13 #GP general protection" }
    if v == 14 { return "14 #PF page fault" }
    return "?? unknown exception"
}

fn exc_common(vec: i32) -> i32 {
    let c = 0
    while c < 80 {
        vga_put2(22, c, 32 | 28672)
        c = c + 1
    }
    puts_at(22, 1, "*** EXCEPTION ***")
    puts_at(23, 1, exc_name(vec))
    logstore("[exc] exception caught -> halted")
    halt()
    return 0
}

fn exc_0() -> i32 { return exc_common(0) }
fn exc_3() -> i32 { return exc_common(3) }
fn exc_6() -> i32 { return exc_common(6) }
fn exc_8() -> i32 { return exc_common(8) }
fn exc_13() -> i32 { return exc_common(13) }
fn exc_14() -> i32 { return exc_common(14) }
fn exc_other() -> i32 { return exc_common(99) }

// ---------- 时钟中断（IRQ0 / vector 0x20） ----------
fn timer_irq() -> i32 {
    push_all()
    store32(20232, load32(20232) + 1)      // 0x4F08 节拍计数
    out8(32, 32)                            // EOI -> 主片
    pop_all()
    irq_return()                            // mov rsp,rbp; pop rbp; iretq
    return 0
}

// ---------- PIC 重映射 ----------
fn pic_remap() -> i32 {
    out8(32, 17)                            // ICW1: ICW4 + 边沿
    out8(160, 17)
    out8(33, 32)                            // ICW2: 主片向量基址 0x20
    out8(161, 40)                           // 从片基址 0x28
    out8(33, 4)                             // ICW3: 从片接在 IRQ2
    out8(161, 2)
    out8(33, 1)                             // ICW4: 8086 模式
    out8(161, 1)
    out8(33, 254)                           // 只开 IRQ0（bit0=0）
    out8(161, 255)                          // 屏蔽从片全部
    return 0
}

// ---------- PIT 时钟（50 Hz） ----------
fn pit_init() -> i32 {
    out8(67, 54)                            // 0x43=0x36: 通道0, lo/hi, 模式3
    out8(64, 55)                            // 分频 23863 = 0x5D37 低字节
    out8(64, 93)                            // 高字节
    return 0
}

// ---------- 日志落盘（热复位交接）----------
// 把日志环 0x4000..0x4EFF（3840 B）拷到低端内存 0x10000，
// 在 0x10010 写魔数 "DSLG"，然后软复位（端口 0x64 写 0xFE）。
// 复位后 MBR 在实模式下检查魔数，用 int 13h AH=43 写进日志分区。
fn savelog() -> i32 {
    let i = 0
    while i < 3840 {
        store8(65536 + i, load8(16384 + i))
        i = i + 1
    }
    store8(65552, 68)          // 'D' 0x10010
    store8(65553, 83)          // 'S'
    store8(65554, 76)          // 'L'
    store8(65555, 71)          // 'G'
    out8(100, 254)             // 0x64 <- 0xFE：暖复位
    return 0
}

fn setup_idt() -> i32 {
    let cs = read_cs()
    if cs == 0 { cs = 24 }
    let v = 0
    while v < 32 {
        let h = fnaddr(exc_other)
        if v == 0 { h = fnaddr(exc_0) }
        if v == 3 { h = fnaddr(exc_3) }
        if v == 6 { h = fnaddr(exc_6) }
        if v == 8 { h = fnaddr(exc_8) }
        if v == 13 { h = fnaddr(exc_13) }
        if v == 14 { h = fnaddr(exc_14) }
        idt_set(v, h, cs)
        v = v + 1
    }
    idt_set(32, fnaddr(timer_irq), cs)      // IRQ0
    store16(20256, 767)                     // IDTR limit = 48*16-1
    store32(20258, 20480)                   // base = 0x5000
    store32(20262, 0)
    lidt(20256)
    return 0
}

fn _start() {
    store32(20224, 0)                   // 日志环计数清零

    clear()
    puts_at(0, 0, "DsOS v1.1  -  kernel compiled from Ds source")
    puts_at(1, 0, "Ds toolchain -> x86-64 machine code")
    divider()
    status_bar()
    setup_idt()

    let row = 4
    row = log(row, "[boot] clear screen .................. ok")
    row = log(row, "[boot] VGA 80x25 text mode ........... ok")
    row = log(row, "[boot] heartbeat timer (port 0x80) ... armed")
    row = log(row, "[boot] keyboard polling (0x64/0x60) .. armed")
    row = log(row, "[boot] memory log ring 0x4000 ....... 60 slots")
    row = log(row, "[boot] IDT 256 gates @0x5000 ......... loaded")
    row = log(row, "[boot] ACPI S5 shutdown ............. ready")
    row = log(row, "[boot] type 'help' then Enter")
    row = log(row, "[boot] entering main loop")

    clear_row(22)
    puts_at(22, 0, "cmd> ")

    let hsh = 0
    let nlen = 0
    let beat = 0
    while 1 == 1 {
        beat = beat + 1
        heartbeat(beat)
        if (beat & 7) == 0 {
            let t = load32(20232)
            puts_at(24, 52, "[tick ")
            vga_put(24, 58, hexc((t >> 12) & 15))
            vga_put(24, 59, hexc((t >> 8) & 15))
            vga_put(24, 60, hexc((t >> 4) & 15))
            vga_put(24, 61, hexc(t & 15))
            puts_at(24, 62, " ]")
        }
        delay(30000)

        let st = in8(100)
        if (st & 1) == 1 {
            let sc = in8(96)
            if sc == 1 { halt() }
            if sc == 28 {                       // Enter
                if nlen > 0 {
                    let known = 0
                    if hsh == 50025 {           // help
                        known = 1
                        row = log(row, "[cmd] help ------------------------")
                        row = log(row, "[cmd]   help      this text")
                        row = log(row, "[cmd]   log       dump memory log ring")
                        row = log(row, "[cmd]   shutdown  ACPI S5 power off")
                        row = log(row, "[cmd]   off       same as shutdown")
                        row = log(row, "[cmd]   exc       trigger int3 (panic test)")
                        row = log(row, "[cmd]   irq       arm PIC+PIT, enable IRQ0")
                        row = log(row, "[cmd]   savelog   save log to USB then reboot")
                        row = log(row, "[cmd]   ESC       halt CPU")
                        row = log(row, "[cmd] ------------------------------")
                    }
                    if hsh == 55842 {           // log
                        known = 1
                        dump_log()
                        puts_at(2, 0, "---- memory log ring --------------------------------")
                        puts_at(20, 0, "---- end of log -------------------------------------")
                        row = 20
                    }
                    if hsh == 14225 {           // savelog
                        known = 1
                        row = log(row, "[log] copying log to low memory 0x10000")
                        row = log(row, "[log] rebooting; MBR will write it to disk")
                        savelog()
                    }
                    if hsh == 52684 {           // irq
                        known = 1
                        row = log(row, "[irq] remapping PIC to 0x20/0x28")
                        pic_remap()
                        row = log(row, "[irq] PIT channel 0 @ 50 Hz")
                        pit_init()
                        row = log(row, "[irq] enabling interrupts (sti)")
                        sti()
                    }
                    if hsh == 48512 {           // exc
                        known = 1
                        row = log(row, "[cmd] exc -> int3")
                        int3()
                    }
                    if hsh == 58811 {           // off
                        known = 1
                        row = log(row, "[cmd] off -> ACPI S5")
                        if shutdown() == 0 {
                            row = log(row, "[acpi] no FADT, halting")
                        }
                        halt()
                    }
                    if hsh == 47452 {           // shutdown
                        known = 1
                        row = log(row, "[cmd] shutdown -> ACPI S5")
                        if shutdown() == 0 {
                            row = log(row, "[acpi] no FADT, halting")
                        }
                        halt()
                    }
                    if known == 0 {
                        row = log(row, "[cmd] unknown, type 'help'")
                    }
                    clear_row(22)
                    puts_at(22, 0, "cmd> ")
                    hsh = 0
                    nlen = 0
                }
            } else {
                if sc == 14 {
                    hsh = 0
                    nlen = 0
                    clear_row(22)
                    puts_at(22, 0, "cmd> ")
                } else {
                    let ch = sc2ascii(sc)
                    if ch != 0 {
                        if nlen < 12 {
                            vga_put(22, 5 + nlen, ch)
                            nlen = nlen + 1
                            hsh = (hsh * 33 + ch) & 65535
                        }
                    }
                }
            }
        }
    }
}
