// mbr.ds — DsOS 主引导记录（MBR），用 Ds 编写，16 位实模式
//
// 职责（只做最少的事）：
//   1. 设置段寄存器与栈
//   2. 用 BIOS int 13h AH=42（LBA 扩展读）把 stage2 + 内核读进内存
//   3. 远跳到 stage2
//
// 职责之外的一切（A20 / GDT / 页表 / 长模式）都交给 stage2。
// 本文件没有一行汇编——所有指令都由 mini16.py 生成。

fn _start16() {
    // ---- 段与栈 ----
    set_ds(0)
    set_es(0)
    set_ss(0)
    mov_sp(31744)                 // 0x7C00

    // ---- 热复位日志交接：上次内核留下的日志还在低端内存吗？----
    // 内核把日志放在 0x10000，并在 0x10010 写魔数 'D'
    set_ds(4096)                  // DS = 0x1000 → 线性 0x10000
    let magic = read8(16)         // 0x10010
    if magic == 68 {
        // 有日志：写 8 扇区到日志分区 LBA 6144，然后清魔数（避免重复写）
        disk_write_lba(6144, 8, 4096, 0)
        write8(16, 0)
        write8(17, 0)
    }
    set_ds(0)

    // ---- 读 32 扇区（LBA 1..32）到 0x0000:0x8000 ----
    // 覆盖 stage2(0x8000..0x8FFF) 与内核槽(0x9000..0xBFFF)
    // LBA 1..32 = CHS(cyl=0, head=0, sector=2..33)，不跨磁道
    disk_read_chs(32, 0, 2, 0, 2048, 0)      // count, cyl, sec, head, seg=0x0800, off=0

    // ---- 跳到 stage2 ----
    far_jmp(0, 32768)             // CS=0, IP=0x8000

    halt()
}
