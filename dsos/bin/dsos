#!/bin/sh
# dsos — 最小 DsOS 运行入口
# 用法：
#   dsos hello.ds             # Step 2：dscc --emit bin，再加载
#   dsos hello.bin            # Step 2 产物
#   dsos --stage4 call.ds     # Step 4：函数/栈帧
#   dsos --stage5 branch.ds   # Step 5：算术/比较/if
#   dsos --native hello.bin   # x86_64 真实 mmap+跳转（仅 Step 2 无栈帧）
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
mode=vm
stage=2
case "${1:-}" in
  --stage4) stage=4; shift ;;
  --stage5) stage=5; shift ;;
  --native) mode=native; shift ;;
esac
if [ $# -ne 1 ]; then
  echo "usage: dsos [--stage4|--stage5|--native] <file.ds|file.bin>" >&2
  exit 2
fi
src=$1
case "$src" in
  *.ds)
    tmp=$(mktemp "${TMPDIR:-/tmp}/dsos.XXXXXX.bin")
    trap 'rm -f "$tmp"' EXIT INT TERM
    if [ "$stage" = 5 ]; then
      "${PYTHON:-python3}" "$root/dsos/toolchain/step5/dscc_step5.py" "$src" --emit bin -o "$tmp" >/dev/null
    elif [ "$stage" = 4 ]; then
      "${PYTHON:-python3}" "$root/dsos/toolchain/step4/dscc_step4.py" "$src" --emit bin -o "$tmp" >/dev/null
    else
      "$root/dscc" "$src" --emit bin -o "$tmp" >/dev/null
    fi
    target=$tmp ;;
  *.bin) target=$src ;;
  *) echo "dsos: 只支持 .ds / .bin" >&2; exit 2 ;;
esac
if [ "$mode" = native ]; then
  exec "${PYTHON:-python3}" "$root/dsos/toolchain/step3/loader_native.py" "$target"
elif [ "$stage" = 4 ] || [ "$stage" = 5 ]; then
  exec "${PYTHON:-python3}" "$root/dsos/toolchain/step4/loader.py" "$target"
else
  exec "${PYTHON:-python3}" "$root/dsos/toolchain/step3/dsos_loader.py" "$target"
fi
