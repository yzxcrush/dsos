struct Module {
    name: [u8; 32],
    entry: u64,
    calls: [u64; 8],
    state: u32,
}

static mut modules: [Module; 64]
static mut module_count: u32 = 0

fn module_load(bin: *u8, len: u64) -> i32 { return -1; }
fn module_unload(name: *u8) -> i32 { return -1; }
